      <aliases enabled='yes' />
      <column caption='Minutes Played' datatype='real' name='[Calculation_2446017553506930688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[ms_played]/60000' />
      </column>
      <column caption='Hours Played' datatype='real' name='[Calculation_2446017553509212161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[ms_played]/3600000' />
      </column>
      <column caption='Artist (KPI)' datatype='integer' name='[Calculation_2446017553510064130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([master_metadata_album_artist_name])' />
      </column>
      <column caption='Track (KPI)' datatype='integer' name='[Calculation_2446017553510182915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([master_metadata_track_name])' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_2446017553534341128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[ts]) = 1 THEN &apos;Monday&apos;&#13;&#10;ELSEIF DATEPART(&apos;weekday&apos;,[ts]) = 2 THEN &apos;Tuesday&apos;&#13;&#10;ELSEIF DATEPART(&apos;weekday&apos;,[ts]) = 3 THEN &apos;Wednesday&apos;&#13;&#10;ELSEIF DATEPART(&apos;weekday&apos;,[ts]) = 4 THEN &apos;Thursday&apos;&#13;&#10;ELSEIF DATEPART(&apos;weekday&apos;,[ts]) = 5 THEN &apos;Friday&apos;&#13;&#10;ELSEIF DATEPART(&apos;weekday&apos;,[ts]) = 6 THEN &apos;Saturday&apos;&#13;&#10;ELSE &apos;Sunday&apos; END' />
      </column>
      <column caption='Time (AM/PM)' datatype='string' name='[Calculation_2446017553536524297]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, [ts]) = 0 THEN &quot;00:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 1 THEN &quot;01:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 2 THEN &quot;02:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 3 THEN &quot;03:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 4 THEN &quot;04:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 5 THEN &quot;05:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 6 THEN &quot;06:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 7 THEN &quot;07:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 8 THEN &quot;08:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 9 THEN &quot;09:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 10 THEN &quot;10:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 11 THEN &quot;11:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 12 THEN &quot;12:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 13 THEN &quot;13:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 14 THEN &quot;14:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 15 THEN &quot;15:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 16 THEN &quot;16:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 17 THEN &quot;17:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 18 THEN &quot;18:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 19 THEN &quot;19:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 20 THEN &quot;20:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 21 THEN &quot;21:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 22 THEN &quot;22:00&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [ts]) = 23 THEN &quot;23:00&quot;&#13;&#10;END' />
      </column>
      <column caption='Online' datatype='boolean' name='[Calculation_2446017553554362380]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [offline] = False THEN True ELSE False END' />
      </column>
      <column caption='Platform' datatype='string' name='[Calculation_2446017553579458573]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([platform],&quot;ios&quot;) THEN &quot;ios&quot;&#13;&#10;ELSEIF CONTAINS([platform],&quot;Android&quot;) THEN &quot;Android&quot;&#13;&#10;ELSE &quot;Windows&quot;&#13;&#10;END' />
      </column>
      <column caption='Month' datatype='datetime' name='[Calculation_3254695164077142016]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[ts])' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_3254695164077572097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [conn_country] = &apos;ZA&apos; THEN &apos;South Africa&apos;&#13;&#10;ELSEIF [conn_country] = &apos;GB&apos; THEN &apos;United Kingdom&apos;&#13;&#10;ELSE &apos;Other&apos;&#13;&#10;END' />
      </column>
      <column caption='Move Period' datatype='string' name='[Calculation_3254695164078325762]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ts] &lt; DATE(&apos;31/08/2023&apos;) THEN &apos;Before Move&apos;&#13;&#10;ELSE &apos;After Move&apos;&#13;&#10;END' />
      </column>
