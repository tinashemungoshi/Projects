          <filter class='categorical' column='[federated.0dlp2860tx1bdh1f84sk40tugamy].[Action (Online)]'>
            <groupfilter function='level-members' level='[Calculation_2446017553554362380]' user:ui-action-filter='[Action8_2D65A6C601374CD5AED851DA5A0F1139]' user:ui-enumeration='all' user:ui-marker='enumerate' />
